# --- Database (contact messages + legal documents) ---
# PostgreSQL connection string used by src/db/index.ts and drizzle.config.ts
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/moawen_db

# --- Site URL (canonical, sitemap, robots, Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://moawen.sa

# --- Admin console (CMS at /admin) ---
# REQUIRED for the admin console to work. There is NO default value —
# without it the admin API fails closed (HTTP 503).
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Email delivery for the contact form (server-side only) ---
# Option A: SMTP (preferred in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional custom From header, e.g. "Moawen <no-reply@moawen.sa>"
SMTP_FROM=

# Option B: Resend REST API
RESEND_API_KEY=
# Optional custom From header, e.g. "Moawen <no-reply@moawen.sa>"
RESEND_FROM=

# NOTE: every contact message is ALWAYS delivered to the fixed official
# inbox support@moawen.sa. The recipient cannot be overridden.

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
